#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
OMARCHY_SOURCE="${OMARCHY_PATH:-/usr/share/omarchy}"
for t in test/*.test.js; do
  node "$t"
done
omarchy plugin validate .
/usr/lib/qt6/bin/qmllint -I "$OMARCHY_SOURCE/shell" Overview.qml WorkspaceTile.qml WindowThumb.qml WheelArea.qml
echo "ok - workspace overview"
